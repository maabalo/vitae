{
  "name": "vitae-resume-builder",
  "version": "1.0.0",
  "private": true,
  "description": "Vitae — resume/CV builder. Runs from index.html; Node is only needed for the lint/format checks.",
  "scripts": {
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js && npm run format:check",
    "lint:html": "html-validate index.html",
    "lint:css": "stylelint \"assets/css/*.css\"",
    "lint:js": "eslint assets/js",
    "format": "prettier --write index.html assets",
    "format:check": "prettier --check index.html assets"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "html-validate": "11.16.2",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0"
  }
}
